# ── Required ──────────────────────────────────────────────────────
# Shared secret for authenticating API requests.
# Generate a strong random passphrase (e.g. `openssl rand -hex 32`).
EBRAM_API_ACCESS_KEY=your-secure-random-passphrase

# Cursor Cloud API key for running the investigation agent.
# https://cursor.com/settings
CURSOR_API_KEY=your-cursor-api-key

# NOTE: agent_backend / agent_model / github_repo / store_records /
# dev_notification_email are no longer env vars — they are configured in
# ebram.config.yaml (orchestrator.bug_triage).

# GitHub personal access token with repo scope for creating issues.
# The target repo is set in ebram.config.yaml (orchestrator.bug_triage.github_repo).
# https://github.com/settings/tokens → classic token, "repo" scope.
GITHUB_TOKEN=your-github-token

# Email address that receives investigation result notifications.
# Configured in ebram.config.yaml (orchestrator.bug_triage.dev_notification_email).
# DEV_NOTIFICATION_EMAIL=your-email@example.com

# Resend API key for sending notification emails.
# https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# "From" address for outgoing notification emails (must be verified in Resend).
MAIL_FROM=bugfixagent@example.com

# ── Optional ──────────────────────────────────────────────────────
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=development
# LOG_LEVEL=info                          # debug | info | warn | error
# RATE_LIMIT_MAX=2                        # max requests per window
# RATE_LIMIT_WINDOW=1 minute              # rate-limit window duration
# RECORD_STORE_ENABLED — replaced by store_records in ebram.config.yaml
# RECORD_STORE_SQLITE_PATH=data/bugfixagent.db
# RECORD_STORE_DUCKDB_PATH=data/analytics.duckdb

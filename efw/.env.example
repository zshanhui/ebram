# ── Set in wrangler.toml [vars] ─────────────────────────────────
BUGFIXAGENT_URL=https://your-bugfixagent.example.com
FALLBACK_EMAIL=you@verified-destination.com
CONTACT_SUCCESS_REDIRECT=https://your-site.example.com/contact?sent=1
CONTACT_ERROR_REDIRECT=https://your-site.example.com/contact?error=1
CONTACT_TO_EMAIL=you@example.com
CONTACT_FORM_ADMIN_SUBJECT=LevelChinese News contact form
MAIL_FROM=bugreport@yourdomain.com

# ── Set via `wrangler secret put` (from efw/) ───────────────────
# wrangler secret put EBRAM_API_ACCESS_KEY
# wrangler secret put RESEND_API_KEY
EBRAM_API_ACCESS_KEY=your-secure-random-passphrase
RESEND_API_KEY=re_your_resend_api_key
